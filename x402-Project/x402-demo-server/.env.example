# x402 Resource Server Configuration
# Algorand TestNet - hosted GoPlausible facilitator

# Your resource server receiving address (for USDC payments)
# See: https://dev.algorand.co/concepts/accounts/create/
AVM_ADDRESS=

# Hosted Facilitator URL (use GoPlausible by default)
FACILITATOR_URL=https://facilitator.goplausible.xyz

# Algorand TestNet Node
ALGOD_SERVER=https://testnet-api.algonode.cloud

# Optional: Server Mnemonic to automatically broadcast cryptographic on-chain Proof-of-Audit notes to Algorand TestNet
ATTESTATION_MNEMONIC=

# Server port
PORT=4021

# Optional: LLM Providers for Tier 2 Semantic Logic Review & AI Diffs
# (Supports Groq, Gemini, or OpenAI with automatic fallback)
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

